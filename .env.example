# Copia este archivo como .env y completa solo lo que necesites.
# SPEED: número positivo. 1 es la velocidad normal; 0.5 ralentiza; 2 acelera.
SPEED=0.8
# HEADLESS: true no muestra Chromium (CI); false muestra la ventana.
HEADLESS=false
# KEEP_OPEN: true deja Chromium abierto al terminar; false lo cierra automáticamente.
KEEP_OPEN=true

# Configuración de Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=
